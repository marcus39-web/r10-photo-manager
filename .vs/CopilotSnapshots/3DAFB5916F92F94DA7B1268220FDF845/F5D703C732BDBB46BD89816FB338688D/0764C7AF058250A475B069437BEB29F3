<Page x:Class="R10CSharp.Pages.SearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="White">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <!-- Filter -->
            <ColumnDefinition Width="*"/>
            <!-- Trefferliste -->
            <ColumnDefinition Width="500"/>
            <!-- Grosse Vorschau -->
        </Grid.ColumnDefinitions>

        <!-- SUCHFELD OBEN -->
        <DockPanel Grid.ColumnSpan="3" LastChildFill="False" Margin="0 0 0 20">
            <TextBox x:Name="SearchBox"
                     Width="400"
                     Height="35"
                     FontSize="18"
                     Margin="0 0 10 0"
                     VerticalContentAlignment="Center" />

            <Button Content="Suchen"
                    Width="120"
                    Height="35"
                    Background="#2ECC71"
                    Foreground="White"
                    FontSize="18"
                    Click="SearchButton_Click"/>
        </DockPanel>

        <!-- FILTER LINKS -->
        <StackPanel Grid.Column="0" Margin="0 60 20 0">
            <TextBlock Text="Filter" FontSize="22" Margin="0 0 0 10"/>

            <ComboBox x:Name="CategoryFilter"
                      FontSize="18"
                      Margin="0 10 0 0"/>

            <ComboBox x:Name="RawJpgFilter"
                      FontSize="18"
                      Margin="0 10 0 0"/>

            <ComboBox x:Name="SeriesFilter"
                      FontSize="18"
                      Margin="0 10 0 0"/>

            <ComboBox x:Name="DateFilter"
                      FontSize="18"
                      Margin="0 10 0 0"/>

            <ComboBox x:Name="FavoritesFilter"
                      FontSize="18"
                      Margin="0 10 0 0"/>
        </StackPanel>

        <!-- TREFFERLISTE MIT KLEINEN THUMBNAILS -->
        <ListView x:Name="ResultList"
                  Grid.Column="1"
                  Margin="0 60 20 0"
                  SelectionChanged="ResultList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Image Source="{Binding Thumbnail}" Width="80" Height="80" Margin="0 0 10 0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding FileName}" FontSize="18"/>
                            <TextBlock Text="{Binding Category}" FontSize="14" Foreground="#555"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- GROSSE BILDVORSCHAU -->
        <Border Grid.Column="2"
                Margin="0 60 0 0"
                BorderBrush="#2ECC71"
                BorderThickness="2"
                CornerRadius="10"
                Padding="10">
            <StackPanel>
                <Image x:Name="PreviewImage"
                       Width="480"
                       Height="480"
                       Stretch="Uniform"
                       Margin="0 0 0 20"/>

                <TextBlock x:Name="PreviewFileName" FontSize="20" Margin="0 0 0 10"/>
                <TextBlock x:Name="PreviewCategory" FontSize="16" Margin="0 0 0 10"/>
                <TextBlock x:Name="PreviewPath" FontSize="14" Foreground="#555"/>

                <TextBox x:Name="PreviewNotes"
                         Height="80"
                         Margin="0 20 0 0"
                         FontSize="16"
                         TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

    </Grid>
</Page>

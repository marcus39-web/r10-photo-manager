using System;
using System.Windows;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.DependencyInjection;
using R10CSharp.Data;
using R10CSharp.Services;

namespace R10CSharp
{
    public partial class App : Application
    {
        private IServiceProvider? _serviceProvider;

        protected override void OnStartup(StartupEventArgs e)
        {
            base.OnStartup(e);

            var services = new ServiceCollection();

            // Einstellungen laden
            var settings = SettingsService.Load();
            services.AddSingleton(settings);

            // DbContext konfigurieren
            services.AddDbContext<R10PhotoContext>(options =>
                options.UseSqlServer(settings.ConnectionString));

            // IndexImportService registrieren
            services.AddScoped<IndexImportService>();

            _serviceProvider = services.BuildServiceProvider();

            // Datenbank sicherstellen / Migrationen anwenden
            try
            {
                using var scope = _serviceProvider.CreateScope();
                var db = scope.ServiceProvider.GetRequiredService<R10PhotoContext>();
                // Für Produktionsreife mit Versionierung nutzen wir Migrationen
                // und wenden sie beim Start an. Database.Migrate() verwendet
                // alle vorhandenen Migrationen.
                db.Database.Migrate();

                // Import vorhandener JSON-Indexdatei in DB
                var importer = scope.ServiceProvider.GetService<IndexImportService>();
                importer?.ImportIfNeededAsync().GetAwaiter().GetResult();
            }
            catch (Exception ex)
            {
                // Bei Fehlern nur protokollieren, App soll weiter starten
                Console.WriteLine($"DB initialisierung fehlgeschlagen: {ex.Message}");
            }
        }
    }
}

using System.Windows;
using System.Windows.Controls;
using R10CSharp.Pages;

namespace R10CSharp
{
    public partial class MainWindow : Window
    {
        public MainWindow()
        {
            InitializeComponent();
            MainFrame.Navigate(new StartPage());

            NavStart.Click += (s, e) => MainFrame.Navigate(new Pages.StartPage());
            NavSearch.Click += (s, e) => MainFrame.Navigate(new Pages.SearchPage());
            NavScan.Click += (s, e) => MainFrame.Navigate(new Pages.ScanPage());
            NavIndex.Click += (s, e) => MainFrame.Navigate(new Pages.IndexPage());
            NavSettings.Click += (s, e) => MainFrame.Navigate(new Pages.SettingsPage());

            TopSearchButton.Click += (s, e) =>
            {
                var q = TopSearchBox.Text;
                MainFrame.Navigate(new Pages.SearchPage(q));
            };
        }
    }
}

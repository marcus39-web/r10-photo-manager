using System;
using System.Windows;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.DependencyInjection;
using R10CSharp.Data;
using R10CSharp.Services;

namespace R10CSharp
{
    public partial class App : Application
    {
        private IServiceProvider? _serviceProvider;

        private static void Log(string message)
        {
            try
            {
                var dir = System.IO.Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Data");
                if (!System.IO.Directory.Exists(dir)) System.IO.Directory.CreateDirectory(dir);
                var path = System.IO.Path.Combine(dir, "app_start_log.txt");
                var line = $"[{DateTime.Now:O}] {message}{Environment.NewLine}";
                System.IO.File.AppendAllText(path, line);
            }
            catch
            {
                // swallow logging errors
            }
        }

        protected override void OnStartup(StartupEventArgs e)
        {
            base.OnStartup(e);
            Log("OnStartup entered");

            var services = new ServiceCollection();

            // Einstellungen laden
            Log("Loading settings");
            var settings = SettingsService.Load();
            Log("Settings loaded");
            services.AddSingleton(settings);

            // DbContext konfigurieren
            services.AddDbContext<R10PhotoContext>(options =>
                options.UseSqlServer(settings.ConnectionString));

            // IndexImportService registrieren
            services.AddScoped<IndexImportService>();

            _serviceProvider = services.BuildServiceProvider();
            Log("ServiceProvider built");

            // Datenbank sicherstellen / Migrationen anwenden
            try
            {
                using var scope = _serviceProvider.CreateScope();
                Log("Creating DbContext");
                var db = scope.ServiceProvider.GetRequiredService<R10PhotoContext>();
                // Für Produktionsreife mit Versionierung nutzen wir Migrationen
                // und wenden sie beim Start an. Database.Migrate() verwendet
                // alle vorhandenen Migrationen.
                Log("Applying migrations (Database.Migrate)");
                db.Database.Migrate();
                Log("Migrations applied");

                // Import vorhandener JSON-Indexdatei in DB
                var importer = scope.ServiceProvider.GetService<IndexImportService>();
                if (importer != null)
                {
                    Log("Starting index import");
                    importer.ImportIfNeededAsync().GetAwaiter().GetResult();
                    Log("Index import finished");
                }
                else
                {
                    Log("No IndexImportService registered");
                }

                // Sichtbare Bestätigung, dass OnStartup erreicht wurde
                MessageBox.Show("Anwendung gestartet. Wenn Sie das Hauptfenster nicht sehen, prüfen Sie bitte Alt+Tab oder mehrere Monitore.", "R10 Photo Manager", MessageBoxButton.OK, MessageBoxImage.Information);
                Log("Showing MessageBox confirmation");

                // Hauptfenster erstellen und anzeigen (StartupUri wurde entfernt)
                try
                {
                    Log("Creating MainWindow");
                    var main = new MainWindow();
                    main.Show();
                    Log("MainWindow shown");
                }
                catch (Exception mwEx)
                {
                    Log($"Fehler beim Erstellen des Hauptfensters: {mwEx.Message}");
                }
            }
            catch (Exception ex)
            {
                // Bei Fehlern nur protokollieren, App soll weiter starten
                Log($"DB initialisierung fehlgeschlagen: {ex.Message}");
            }
        }
    }
}

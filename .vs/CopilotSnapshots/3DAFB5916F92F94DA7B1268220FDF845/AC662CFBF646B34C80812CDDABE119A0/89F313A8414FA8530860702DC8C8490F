using System;
using System.IO;
using System.Threading.Tasks;
using System.Windows;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.DependencyInjection;
using R10CSharp.Data;
using R10CSharp.Services;

namespace R10CSharp
{
    public partial class App : Application
    {
        static App()
        {
            try
            {
                var dir = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Data");
                Directory.CreateDirectory(dir);
                var path = Path.Combine(dir, "app_error_log.txt");

                AppDomain.CurrentDomain.UnhandledException += (s, e) =>
                {
                    try
                    {
                        var ex = e.ExceptionObject as Exception;
                        File.AppendAllText(path, $"[Unhandled] {DateTime.Now:O} {ex}\n");
                    }
                    catch { }
                };

                TaskScheduler.UnobservedTaskException += (s, e) =>
                {
                    try
                    {
                        File.AppendAllText(path, $"[UnobservedTask] {DateTime.Now:O} {e.Exception}\n");
                    }
                    catch { }
                };
            }
            catch { }
        }

        private IServiceProvider? _serviceProvider;

        private static void Log(string message)
        {
            // minimal logging disabled in cleanup
        }

        protected override void OnStartup(StartupEventArgs e)
        {
            base.OnStartup(e);
            Log("OnStartup entered");

            var services = new ServiceCollection();

            // Einstellungen laden
            Log("Loading settings");
            var settings = SettingsService.Load();
            Log("Settings loaded");
            services.AddSingleton(settings);

            // DbContext konfigurieren
            services.AddDbContext<R10PhotoContext>(options =>
                options.UseSqlServer(settings.ConnectionString));

            // IndexImportService registrieren
            services.AddScoped<IndexImportService>();

            _serviceProvider = services.BuildServiceProvider();
            Log("ServiceProvider built");

            // Erzeuge und zeige das Hauptfenster sofort. DB-Migration und Import laufen im Hintergrund,
            // damit ein Fehler bei der DB-Initialisierung die UI nicht blockiert.
            try
            {
                // Temporäres Testfenster anzeigen, um WPF-Rendering/Windowing zu prüfen
                try
                {
                    Log("Creating TestWindow");
                    var test = new Window
                    {
                        Title = "R10 Photo Manager - Testfenster",
                        Width = 480,
                        Height = 240,
                        Content = new System.Windows.Controls.TextBlock { Text = "Testfenster: UI ist funktionsfähig.", VerticalAlignment = System.Windows.VerticalAlignment.Center, HorizontalAlignment = System.Windows.HorizontalAlignment.Center },
                    };
                    test.Show();
                    Log("TestWindow shown");
                }
                catch (Exception twEx)
                {
                    Log($"TestWindow error: {twEx}");
                }

                Log("Creating MainWindow");
                MainWindow? main = null;
                try
                {
                    main = new MainWindow();
                    main.Show();
                    Log("MainWindow shown");
                }
                catch (Exception mwEx)
                {
                    Log($"Fehler beim Erstellen des Hauptfensters: {mwEx}");
                }

                // Migrationen und Import asynchron im Hintergrund ausführen
                _ = Task.Run(async () =>
                {
                    try
                    {
                        using var bgScope = _serviceProvider.CreateScope();
                        var bgDb = bgScope.ServiceProvider.GetRequiredService<R10PhotoContext>();
                        Log("Background: Applying migrations (Database.MigrateAsync)");
                        await bgDb.Database.MigrateAsync().ConfigureAwait(false);
                        Log("Background: Migrations applied");

                        var bgImporter = bgScope.ServiceProvider.GetService<IndexImportService>();
                        if (bgImporter != null)
                        {
                            Log("Background: Starting index import");
                            await bgImporter.ImportIfNeededAsync().ConfigureAwait(false);
                            Log("Background: Index import finished");
                        }
                        else
                        {
                            Log("Background: No IndexImportService registered");
                        }
                    }
                    catch (Exception bgEx)
                    {
                        Log($"Background error: {bgEx}");
                    }
                });
            }
            catch (Exception ex)
            {
                Log($"Startup error: {ex}");
            }
        }
    }
}

<Window x:Class="R10CSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="R10 Photo Manager" Height="800" Width="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" Background="#F5F5F5">
            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text="R10 Photo" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" />
                <Button x:Name="NavStart" Content="Start" Margin="0,4" Padding="8" />
                <Button x:Name="NavSearch" Content="Suche" Margin="0,4" Padding="8" />
                <Button x:Name="NavScan" Content="Scan" Margin="0,4" Padding="8" />
                <Button x:Name="NavIndex" Content="Index" Margin="0,4" Padding="8" />
                <Button x:Name="NavSettings" Content="Einstellungen" Margin="0,4" Padding="8" />
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Column="1">
            <DockPanel DockPanel.Dock="Top" Background="#EEEEEE" Height="48">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8">
                    <TextBox x:Name="TopSearchBox" Width="300" Height="28" Margin="4" />
                    <Button x:Name="TopSearchButton" Content="Suchen" Height="28" Margin="4" />
                </StackPanel>
            </DockPanel>

            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" />

            <StatusBar DockPanel.Dock="Bottom">
                <StatusBarItem Content="Bereit" />
            </StatusBar>
        </DockPanel>
    </Grid>
</Window>


    <Page x:Class="R10CSharp.Pages.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="White">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Width="640">

            <TextBlock Text="Willkommen" FontSize="32" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />

            <!-- Optionales Willkommensbild: Datei Assets/welcome.png verwenden, wenn vorhanden -->
            <Image Source="/Assets/welcome.png" Width="360" Height="200" Stretch="Uniform" Margin="0,0,0,20" Visibility="Collapsed" x:Name="WelcomeImage" />

            <!-- Große, auffällige Aktions-Buttons auf der Startseite -->
            <Button x:Name="SearchButton" Content="Suche" Style="{StaticResource PageButtonStyle}" />
            <Button x:Name="ScanButton" Content="Scan" Style="{StaticResource PageButtonStyle}" />
            <Button x:Name="IndexButton" Content="Index" Style="{StaticResource PageButtonStyle}" />
            <Button x:Name="SettingsButton" Content="Einstellungen" Style="{StaticResource PageButtonStyle}" />

        </StackPanel>
    </Grid>
</Page>

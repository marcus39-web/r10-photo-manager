<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">
	<Identity Name="Marcus39Web.R10PhotoManager" Publisher="CN=Marcus39Web" Version="1.0.0.1" />
  <Properties>
	<DisplayName>R10 Photo Manager</DisplayName>
	<PublisherDisplayName>Marcus39Web</PublisherDisplayName>
	<Description>Lokaler Foto-Manager für Windows.</Description>
	<Logo>Assets\StoreLogo.jpg</Logo>
  </Properties>
  <Dependencies>
	<TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>
  <Resources>
	<Resource Language="de-DE" />
  </Resources>
  <Applications>
	<Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="Windows.FullTrustApplication">
	  <uap:VisualElements DisplayName="R10 Photo Manager" Description="R10 Photo Manager" BackgroundColor="transparent" AppListEntry="default" Square150x150Logo="Assets\Square150x150Logo.jpg" Square44x44Logo="Assets\Square44x44Logo.jpg">
		<uap:DefaultTile Wide310x150Logo="Assets\Square150x150Logo.jpg" />
		<uap:SplashScreen Image="Assets\SplashScreen.jpg" />
	  </uap:VisualElements>
	  <Extensions>
		<desktop:Extension Category="windows.fullTrustProcess" Executable="$targetnametoken$.exe" />
	  </Extensions>
	</Application>
  </Applications>
  <Capabilities>
	<rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>

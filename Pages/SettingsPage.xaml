<Page x:Class="R10CSharp.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="White">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Einstellungen" FontSize="28" Margin="0 0 0 20"/>

            <!-- Archivpfad -->
            <TextBlock Text="Fotoarchiv-Pfad:" FontSize="18"/>
            <TextBox x:Name="ArchivePathBox" Width="400" Margin="0 0 0 10"/>

            <!-- Indexpfad -->
            <TextBlock Text="Index-Datei-Pfad:" FontSize="18"/>
            <TextBox x:Name="IndexPathBox" Width="400" Margin="0 0 0 10"/>

            <!-- Standardfilter -->
            <TextBlock Text="Standard-Filter (RAW/JPG):" FontSize="18"/>
            <ComboBox x:Name="DefaultFilterBox" Width="200" Margin="0 0 0 10">
                <ComboBoxItem Content="RAW"/>
                <ComboBoxItem Content="JPG"/>
            </ComboBox>

            <!-- Theme -->
            <TextBlock Text="Theme-Farbe:" FontSize="18"/>
            <ComboBox x:Name="ThemeBox" Width="200" Margin="0 0 0 20">
                <ComboBoxItem Content="Gruen-Weiss"/>
                <ComboBoxItem Content="Dunkel"/>
                <ComboBoxItem Content="Hell"/>
            </ComboBox>

            <!-- Speichern -->
            <Button Content="Speichern"
                    Width="200" Height="50"
                    Background="#2ECC71"
                    Foreground="White"
                    FontSize="20"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Page>

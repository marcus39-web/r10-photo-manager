<Page x:Class="R10CSharp.Pages.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="White">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">

            <Button x:Name="SearchButton" Content="Suche"
                    Width="300" Height="80"
                    Background="#2ECC71"
                    Foreground="White"
                    FontSize="28"/>

            <Button x:Name="ScanButton" Content="Scan"
                    Width="300" Height="80"
                    Background="#2ECC71"
                    Foreground="White"
                    FontSize="28"/>

            <Button x:Name="IndexButton" Content="Index"
                    Width="300" Height="80"
                    Background="#2ECC71"
                    Foreground="White"
                    FontSize="28"/>

            <Button x:Name="SettingsButton" Content="Einstellungen"
                    Width="300" Height="80"
                    Background="#2ECC71"
                    Foreground="White"
                    FontSize="28"/>

        </StackPanel>
    </Grid>
</Page>
